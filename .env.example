DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socity_backend?sslmode=disable
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/socity_backend?sslmode=disable
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ADMIN_BOOTSTRAP_EMAIL=admin@optizenqor.app
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_admin_password
ADMIN_BOOTSTRAP_NAME=Platform Admin
ADMIN_BOOTSTRAP_ROLE=superadmin
ADMIN_BOOTSTRAP_FORCE_SYNC=false

SESSION_ACCESS_EXPIRES_IN=1h
SESSION_REFRESH_EXPIRES_IN=30d
JWT_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ADMIN_SECRET=replace_with_long_random_admin_secret_if_you_split_admin_tokens

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=OptiZenqor Socity
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
SUPPORT_CONTACT_EMAIL=support@optizenqor.app
SUPPORT_ESCALATION_EMAIL=trust@optizenqor.app
SUPPORT_RESPONSE_TIME=Usually within 24 hours

# Firebase Cloud Messaging for mobile push delivery.
# The app should send its FCM token to POST /notifications/devices after login.
# Use either FIREBASE_SERVICE_ACCOUNT_JSON / FIREBASE_SERVICE_ACCOUNT_BASE64
# or the three separate service-account fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_CAMPAIGN_POLL_MS=60000

# Local frontend origins
# Public web frontend
FRONTEND_URL=http://localhost:5173
# Admin dashboard
CLIENT_URL=http://localhost:4173
# Mobile deep-link scheme
MOBILE_APP_SCHEME=optizenqor
# Primary CORS origin and the explicit allow-list used by backend + docs
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:3000

# Optional explicit platform URLs
DASHBOARD_URL=http://localhost:4173
WEB_FRONTEND_URL=http://localhost:5173
PAYMENT_PUBLIC_BASE_URL=http://localhost:3000
PAYMENT_FRONTEND_RETURN_URL=http://localhost:5173

# Payment gateways. Keep these only on the backend.
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
TWOCHECKOUT_SANDBOX=true
TWOCHECKOUT_MERCHANT_CODE=your_2checkout_merchant_code
TWOCHECKOUT_SECRET_WORD=your_2checkout_buy_link_secret_word
TWOCHECKOUT_SECRET_KEY=your_2checkout_ipn_secret_key
TWOCHECKOUT_CHECKOUT_URL=https://secure.2checkout.com/checkout/buy

# Production example
# FRONTEND_URL=https://your-frontend-app.vercel.app
# CLIENT_URL=https://your-dashboard-app.vercel.app
# WEB_FRONTEND_URL=https://your-frontend-app.vercel.app
# DASHBOARD_URL=https://your-dashboard-app.vercel.app
# CORS_ORIGIN=https://your-frontend-app.vercel.app
# CORS_ORIGINS=https://your-frontend-app.vercel.app,https://your-dashboard-app.vercel.app,https://opti-zenqor-social-backend.vercel.app
#
# Vercel backend project example
# VERCEL_URL=your-backend-project.vercel.app
# FRONTEND_URL=https://your-web-project.vercel.app
# CLIENT_URL=https://your-dashboard-project.vercel.app
# WEB_FRONTEND_URL=https://your-web-project.vercel.app
# DASHBOARD_URL=https://your-dashboard-project.vercel.app
# CORS_ORIGIN=https://your-web-project.vercel.app
# CORS_ORIGINS=https://your-web-project.vercel.app,https://your-dashboard-project.vercel.app,https://your-backend-project.vercel.app
UPLOAD_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
REALTIME_ALLOW_USERID_FALLBACK=false
RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

VERCEL_URL=opti-zenqor-social-backend.vercel.app
